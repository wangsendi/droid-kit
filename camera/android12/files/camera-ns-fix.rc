# droid-kit: allow the vendor camera provider to resolve system libraries used
# by the legacy camera.v4l2 HAL.
#
# The provider service itself is a vendor process. Its passthrough loader
# (android_load_sphal_library) uses the "sphal" namespace, which does not
# include /system/lib64 by default. The HAL links libcamera_client.so and
# libcamera_metadata.so from the system partition, so append /system/lib64 to
# the sphal search/permitted paths and restart the provider.
#
# The live file is /linkerconfig/ld.config.txt. /linkerconfig/default is hidden
# by the linkerconfig bind mount on Android 12.
#
# Verify after boot:
#   adb shell 'grep -n "namespace.sphal" /linkerconfig/ld.config.txt | head'
#   adb shell 'lshal | grep -i camera'
on property:sys.boot_completed=1
    exec -- /system/bin/sh -c "f=/linkerconfig/ld.config.txt; [ -f $f ] && sed -i '/^[[:space:]]*namespace.sphal.search.paths/ a namespace.sphal.search.paths += /system/lib64' $f; [ -f $f ] && sed -i '/^[[:space:]]*namespace.sphal.permitted.paths/ a namespace.sphal.permitted.paths += /system/lib64' $f"
    restart vendor.camera-provider-2-4
