+bool StreamFormat::GetPreferredCaptureSize(
+    const std::set<std::array<int32_t, 2>>& sizes,
+    std::array<int32_t, 2>* out_size) {
+  if (!out_size || sizes.empty()) {
+    return false;
+  }
+
+  // The loopback device is fed at 1280x720, so prefer capturing at that size
+  // when the device reports it; other sizes may not match what the producer
+  // writes (droid-kit).
+  const std::array<int32_t, 2> preferred_size = {{1280, 720}};
+  auto it = sizes.find(preferred_size);
+  if (it != sizes.end()) {
+    *out_size = *it;
+    return true;
+  }
+
+  // Otherwise capture at the largest reported size to avoid upscaling.
+  *out_size = *sizes.rbegin();
+  return true;
+}
