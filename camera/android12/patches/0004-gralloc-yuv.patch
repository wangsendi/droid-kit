diff --git a/modules/gralloc/gralloc.cpp b/modules/gralloc/gralloc.cpp
index 87bda975..977c64ed 100644
--- a/modules/gralloc/gralloc.cpp
+++ b/modules/gralloc/gralloc.cpp
@@ -62,6 +62,11 @@ extern int gralloc_lock(gralloc_module_t const* module,
 extern int gralloc_unlock(gralloc_module_t const* module, 
         buffer_handle_t handle);
 
+extern int gralloc_lock_ycbcr(gralloc_module_t const* module,
+        buffer_handle_t handle, int usage,
+        int l, int t, int w, int h,
+        struct android_ycbcr* ycbcr);
+
 extern int gralloc_register_buffer(gralloc_module_t const* module,
         buffer_handle_t handle);
 
@@ -89,6 +94,7 @@ struct private_module_t HAL_MODULE_INFO_SYM = {
         .unregisterBuffer = gralloc_unregister_buffer,
         .lock = gralloc_lock,
         .unlock = gralloc_unlock,
+        .lock_ycbcr = gralloc_lock_ycbcr,
     },
     .framebuffer = 0,
     .flags = 0,
@@ -207,8 +213,27 @@ static int gralloc_alloc(alloc_device_t* dev,
     if (!pHandle || !pStride)
         return -EINVAL;
 
+    // droid-kit: the AOSP software gralloc only handled RGB formats.  Camera
+    // streams (and Camera2 ImageReaders) also need YUV buffers, so accept the
+    // YUV formats the V4L2 camera HAL advertises.
     int bytesPerPixel = 0;
+    int yuv_code = 0;
     switch (format) {
+        case 0x23:        // HAL_PIXEL_FORMAT_YCbCr_420_888
+            yuv_code = 1;
+            break;
+        case 0x32315659:  // HAL_PIXEL_FORMAT_YV12
+            yuv_code = 2;
+            break;
+        case 0x11:        // HAL_PIXEL_FORMAT_YCrCb_420_SP (NV21)
+            yuv_code = 3;
+            break;
+        case 0x14:        // HAL_PIXEL_FORMAT_YCbCr_422_I (YUYV)
+            yuv_code = 4;
+            break;
+        case 0x10:        // HAL_PIXEL_FORMAT_YCbCr_422_SP
+            yuv_code = 5;
+            break;
         case HAL_PIXEL_FORMAT_RGBA_FP16:
             bytesPerPixel = 8;
             break;
@@ -232,7 +257,16 @@ static int gralloc_alloc(alloc_device_t* dev,
     const size_t tileHeight = 2;
 
     size_t stride = align(width, tileWidth);
-    size_t size = align(height, tileHeight) * stride * bytesPerPixel + 4;
+    size_t size;
+    if (yuv_code == 1 || yuv_code == 2 || yuv_code == 3) {
+        // 4:2:0, 8 bits per sample, one full luma plane plus two half planes.
+        size = stride * align(height, tileHeight) * 3 / 2;
+    } else if (yuv_code == 4 || yuv_code == 5) {
+        // 4:2:2, two bytes per pixel.
+        size = stride * 2 * align(height, tileHeight);
+    } else {
+        size = align(height, tileHeight) * stride * bytesPerPixel + 4;
+    }
 
     int err;
     if (usage & GRALLOC_USAGE_HW_FB) {
@@ -245,6 +279,13 @@ static int gralloc_alloc(alloc_device_t* dev,
         return err;
     }
 
+    // Remember the layout for (*lock_ycbcr)(); keep PRIV_FLAGS_FRAMEBUFFER
+    // intact.  The format itself may not fit in the flag word (YV12 is a
+    // fourcc), so store a small layout code instead.
+    const_cast<private_handle_t*>(
+        reinterpret_cast<const private_handle_t*>(*pHandle))
+        ->flags |= (yuv_code << 8);
+
     *pStride = stride;
     return 0;
 }
diff --git a/modules/gralloc/mapper.cpp b/modules/gralloc/mapper.cpp
index ee3e40e0..e9025de6 100644
--- a/modules/gralloc/mapper.cpp
+++ b/modules/gralloc/mapper.cpp
@@ -185,3 +185,75 @@ int gralloc_unlock(gralloc_module_t const* /*module*/,
         return -EINVAL;
     return 0;
 }
+
+int gralloc_lock_ycbcr(gralloc_module_t const* /*module*/,
+        buffer_handle_t handle, int /*usage*/,
+        int /*l*/, int /*t*/, int w, int h,
+        struct android_ycbcr* ycbcr)
+{
+    // droid-kit: expose the YUV buffer layouts that gralloc_alloc() now
+    // supports so that the camera HAL and Camera2 ImageReaders can map them.
+    if (!ycbcr || private_handle_t::validate(handle) < 0)
+        return -EINVAL;
+
+    private_handle_t* hnd = (private_handle_t*)handle;
+    uint8_t* base = reinterpret_cast<uint8_t*>(hnd->base);
+    int yuv_code = (hnd->flags >> 8) & 0xF;
+    size_t stride = (w + 1) & ~static_cast<size_t>(1);
+
+    memset(ycbcr, 0, sizeof(*ycbcr));
+    switch (yuv_code) {
+        case 1: {  // HAL_PIXEL_FORMAT_YCbCr_420_888, planar U then V
+            size_t cstride = stride / 2;
+            size_t ysize = stride * h;
+            ycbcr->y = base;
+            ycbcr->cb = base + ysize;
+            ycbcr->cr = base + ysize + cstride * (h / 2);
+            ycbcr->ystride = stride;
+            ycbcr->cstride = cstride;
+            ycbcr->chroma_step = 1;
+            return 0;
+        }
+        case 2: {  // HAL_PIXEL_FORMAT_YV12, planar V then U
+            size_t cstride = stride / 2;
+            size_t ysize = stride * h;
+            ycbcr->y = base;
+            ycbcr->cr = base + ysize;
+            ycbcr->cb = base + ysize + cstride * (h / 2);
+            ycbcr->ystride = stride;
+            ycbcr->cstride = cstride;
+            ycbcr->chroma_step = 1;
+            return 0;
+        }
+        case 3: {  // HAL_PIXEL_FORMAT_YCrCb_420_SP (NV21), VU interleaved
+            ycbcr->y = base;
+            ycbcr->cr = base + stride * h;
+            ycbcr->cb = base + stride * h + 1;
+            ycbcr->ystride = stride;
+            ycbcr->cstride = stride;
+            ycbcr->chroma_step = 2;
+            return 0;
+        }
+        case 4: {  // HAL_PIXEL_FORMAT_YCbCr_422_I (YUYV), YUYV interleaved
+            size_t bstride = stride * 2;
+            ycbcr->y = base;
+            ycbcr->cb = base + 1;
+            ycbcr->cr = base + 3;
+            ycbcr->ystride = bstride;
+            ycbcr->cstride = bstride;
+            ycbcr->chroma_step = 2;
+            return 0;
+        }
+        case 5: {  // HAL_PIXEL_FORMAT_YCbCr_422_SP, semi-planar
+            ycbcr->y = base;
+            ycbcr->cb = base + stride * h;
+            ycbcr->cr = base + stride * h + 1;
+            ycbcr->ystride = stride;
+            ycbcr->cstride = stride;
+            ycbcr->chroma_step = 2;
+            return 0;
+        }
+        default:
+            return -EINVAL;
+    }
+}
