+// Returns the numeric suffix of a /dev/videoN path, or -1 if it has none.
+int VideoNodeNumber(const std::string& node) {
+  size_t last_digit = node.find_last_not_of("0123456789");
+  if (last_digit == std::string::npos || last_digit + 1 == node.size()) {
+    return -1;
+  }
+  return std::atoi(node.c_str() + last_digit + 1);
+}
+
+// Orders /dev/videoN nodes numerically (video2 before video10) so that the
+// camera id assignment does not depend on readdir() order. With one back and
+// one front node this makes /dev/video0 -> id 0 and /dev/video1 -> id 1.
+bool CompareVideoNodes(const std::string& a, const std::string& b) {
+  const int a_num = VideoNodeNumber(a);
+  const int b_num = VideoNodeNumber(b);
+  if (a_num != b_num) {
+    return a_num < b_num;
+  }
+  return a < b;
+}
+
+}  // namespace
